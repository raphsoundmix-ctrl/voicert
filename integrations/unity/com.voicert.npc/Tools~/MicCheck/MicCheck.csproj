<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone "does FMOD hear the microphone?" checker.

    Lives under Tools~ so Unity's asset importer ignores it: the trailing tilde is
    the UPM convention for files that ship with a package but are not Unity assets.
    This is a plain .NET console app, built and run OUTSIDE Unity on purpose — the
    whole point is to answer the question without the editor, the player, or the
    game's own audio system in the picture.

    Build:  dotnet build using Release configuration
    Run:    bin\Release\net8.0\MicCheck.exe list
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MicCheck</AssemblyName>
    <RootNamespace>MicCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- FMOD's own binding trips these; they are not ours to fix. -->
    <NoWarn>CS0169;CS0649;CS8500;SYSLIB1054;CS0414</NoWarn>
  </PropertyGroup>

  <!--
    Where FMOD for Unity is installed. Override on the command line if the Unity
    project lives somewhere else:
      dotnet build with property FmodUnityDir set to your FMOD folder
  -->
  <PropertyGroup>
    <FmodUnityDir Condition="'$(FmodUnityDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..\..\Unity VoiceRT\VoiceRT Unity\Assets\Plugins\FMOD</FmodUnityDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MicCheck.cs" />
    <!--
      The C# binding is taken from the FMOD install rather than vendored, so this
      tool can never drift from the version the game actually runs.
    -->
    <Compile Include="$(FmodUnityDir)\src\fmod.cs" />
    <Compile Include="$(FmodUnityDir)\src\fmod_dsp.cs" />
    <Compile Include="$(FmodUnityDir)\src\fmod_studio.cs" />
  </ItemGroup>

  <!--
    FMOD for Unity ships ONE Windows library containing both the core and studio
    APIs. The binding imports them under two names, so MicCheck.cs installs a
    DllImport resolver that points both at this single file; copying it once is
    enough. Copying it twice under two names would load the library twice and
    every core call would land in the instance that does not own the handles.
  -->
  <Target Name="CopyFmodNative" AfterTargets="Build">
    <Copy SourceFiles="$(FmodUnityDir)\platforms\win\lib\x86_64\fmodstudio.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(FmodUnityDir)\platforms\win\lib\x86_64\fmodstudio.dll')" />
    <Warning Text="fmodstudio.dll not found under $(FmodUnityDir). Set the FmodUnityDir property to your FMOD for Unity install, or copy the DLL next to MicCheck.exe by hand."
             Condition="!Exists('$(FmodUnityDir)\platforms\win\lib\x86_64\fmodstudio.dll')" />
  </Target>

</Project>
