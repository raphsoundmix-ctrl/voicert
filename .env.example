# Copy to .env and fill in. .env is git-ignored already (.gitignore carries
# `.env`, `.env.*` and `!.env.example`), and .dockerignore keeps it out of
# every image layer. Compose reads ./.env automatically for ${VAR}
# interpolation -- docker-compose.yml forwards these by name, so nothing
# else you keep in .env leaks into the container.

# --- host ports -------------------------------------------------------------
# 8765 is not reliably free. Change these if `compose up` reports
# "ports are not available", and change the Unity NPC inspector to match.
VOICERT_HOST_PORT=8767
VOICERT_LOCAL_HOST_PORT=8766

# --- bridge tuning ----------------------------------------------------------
# One live NPC = one session. The healthcheck opens one too, briefly, every
# 30s: leave headroom above the number of NPCs you expect to be connected.
VOICERT_MAX_SESSIONS=8
VOICERT_LOG_LEVEL=INFO
# Seconds to let live turns finish after SIGTERM. Must stay below the
# stop_grace_period in docker-compose.yml (20s).
VOICERT_SHUTDOWN_GRACE=5

# --- local model path (profile: local) --------------------------------------
# From inside a container, the host is host.docker.internal -- 127.0.0.1 is
# the container itself. On Docker Desktop for Windows this reaches an Ollama
# bound to host loopback; on a Linux host you must set OLLAMA_HOST=0.0.0.0:11434.
VOICERT_OLLAMA_URL=http://host.docker.internal:11434
VOICERT_OLLAMA_MODEL=qwen3:1.7b
VOICERT_OLLAMA_NUM_PREDICT=120

# --- cloud provider keys ----------------------------------------------------
# HONEST STATUS: every adapter in src/voicert/processors/adapters.py raises
# NotImplementedError today, and the bridge's default runtime uses stub
# providers. These are forwarded and ready; nothing reads them yet. Leave
# them blank until a runtime_factory actually wires a provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
