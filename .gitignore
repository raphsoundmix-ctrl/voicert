# --- Unity local-package consumption (added with the VoiceRT workspace) ---
# A Unity project that references
# integrations/unity/com.voicert.npc through a relative file: path in its
# Packages/manifest.json. A file: package is a LOCAL package: Unity references
# it in place rather than copying it to PackageCache, so the editor will start
# writing .meta files INTO THIS REPO under integrations/unity/com.voicert.npc/.
# Those .meta files MUST be committed - they carry the stable asset GUIDs that
# keep scene and prefab references intact for every consumer of the package.
# They are intentionally NOT ignored here. Do not add *.meta.
.vs/
*.csproj.user

# Voice demo scratch: a running server's log, the probe's rendered player lines,
# and the ducking samples a live test writes.
.voicert-server.log
.duck-samples.txt
examples/.voice-cache/
